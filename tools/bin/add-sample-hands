# Script to add the sample hands (SampleHands - folds in every round, check-raises, all-ins,
# a side pot, a split pot, ...) to a player profile's hand-history database, as a new
# "Sample Hands" tournament.  Run it with the game closed; the game locks the database.
#
#   add-sample-hands -name <profile> [-key <key>]
#
# -key picks the database a client started with that -key uses (e.g. the player1/player2
# aliases); like the game, it needs settings.debug.override.key=true.

runjava poker com.donohoedigital.games.poker.AddSampleHands "$@"
